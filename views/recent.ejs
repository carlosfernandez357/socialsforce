<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Recent News - SocialsForce</title>

    <meta
        name="description"
        content="Discover the latest news, stories and trends published on SocialsForce."
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

</head>


<body>


    <%- include("partials/header") %>


    <main id="recent-page">


        <section class="listing-page-section">

            <div class="content-container">


                <div class="listing-page-header">

                    <span class="listing-page-label">
                        SocialsForce
                    </span>

                    <h1 class="listing-page-title">
                        Recent News
                    </h1>

                    <p class="listing-page-description">
                        The latest stories, news and trends from around the internet.
                    </p>

                </div>


                <% if (posts && posts.length > 0) { %>

                <div class="listing-posts-grid">

                    <% posts.forEach(post => { %>

                    <article class="post-card">

                        <a href="/article/<%= post.slug %>">


                            <% if (post.image) { %>

                            <img
                                src="<%= post.image %>"
                                alt="<%= post.title %>"
                                class="post-image"
                            >

                            <% } %>


                            <div class="post-content">


                                <% if (post.category) { %>

                                <span class="post-category">
                                    <%= post.category %>
                                </span>

                                <% } %>


                                <h2 class="post-title">
                                    <%= post.title %>
                                </h2>


                                <% if (post.excerpt) { %>

                                <p class="post-summary">
                                    <%= post.excerpt %>
                                </p>

                                <% } %>


                                <span class="post-date">

                                    <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric"
                                    }) %>

                                </span>


                            </div>

                        </a>

                    </article>

                    <% }) %>

                </div>


                <% } else { %>

                <div class="empty-posts">

                    <h2>
                        No news available
                    </h2>

                    <p>
                        There are no published articles yet.
                    </p>

                </div>

                <% } %>


            </div>

        </section>


    </main>


    <%- include("partials/footer") %>


    <script src="/js/main.js"></script>


</body>

</html>