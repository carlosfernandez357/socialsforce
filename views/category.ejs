<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <link rel="icon" href="/images/logo.png" type="image/png">

    <%- include('partials/seo', {
        title: category + ' - SocialsForce',
        description: 'Latest ' + category + ' news, stories and trends on SocialsForce.',
        canonicalUrl: 'https://socialsforce.com/category/' + encodeURIComponent(String(category).toLowerCase()),
        ogImage: '/images/logo.png',
        pageType: 'website',
        robots: 'index, follow, max-image-preview:large'
    }) %>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/sidebar.css">
</head>

<%- include("partials/analytics") %>
<body>


    <%- include("partials/header") %>


    <main id="category-page">


        <section class="listing-page-section">

            <div class="content-container">


                <div class="listing-page-header">

                    <span class="listing-page-label">
                        Category
                    </span>

                    <h1 class="listing-page-title">
                        <%= category %>
                    </h1>

                    <p class="listing-page-description">
                        Latest stories, news and trends from <%= category %>.
                    </p>

                </div>


                <div class="content-sidebar-layout">

                <div class="main-content">

                <% if (posts && posts.length > 0) { %>


                <div class="listing-posts-grid">


                    <% posts.forEach(post => { %>


                    <article class="post-card">

                        <a
                            href="/article/<%= post.slug %>"
                        >


                            <% if (post.image) { %>

                            <img
                                src="<%= post.image %>"
                                alt="<%= post.title %>"
                                class="post-image"
                            >

                            <% } %>


                            <div class="post-content">


                                <span class="post-category">
                                    <%= post.category %>
                                </span>


                                <h2 class="post-title">
                                    <%= post.title %>
                                </h2>


                                <% if (post.excerpt) { %>

                                <p class="post-summary">
                                    <%= post.excerpt %>
                                </p>

                                <% } %>


                                <span class="post-date">

                                    <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric"
                                    }) %>

                                </span>


                            </div>

                        </a>

                    </article>


                    <% }) %>


                </div>


                <% } else { %>


                <div class="empty-posts">

                    <h2>
                        No articles found
                    </h2>

                    <p>
                        There are no published articles in this category yet.
                    </p>

                </div>


                <% } %>

                </div>

                <aside class="sidebar" aria-label="More articles">
                    <%- include('partials/sidebar', { sidebarData: typeof sidebarData !== "undefined" ? sidebarData : null }) %>
                </aside>

                </div>



            </div>

        </section>


    </main>


    <%- include("partials/footer") %>


    <script src="/js/main.js"></script>


</body>

</html>