<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/logo.png" type="image/png">

    <%- include('partials/seo', {
        title: query ? ('Search: ' + query + ' | SocialsForce') : 'Search - SocialsForce',
        description: query ? ('Search results for "' + query + '" on SocialsForce.') : 'Search news, trends and topics on SocialsForce.',
        canonicalUrl: 'https://socialsforce.com/search',
        ogImage: '/images/logo.png',
        pageType: 'website',
        robots: 'noindex, follow'
    }) %>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/sidebar.css">

</head>
<body>
<%- include("partials/analytics") %>
<%- include("partials/header") %>

<main class="search-page">

    <div class="content-container content-sidebar-layout">

      <div class="main-content">

        <h1>
            Search
        </h1>

        <form action="/search" method="GET">

            <input
                type="text"
                name="q"
                value="<%= query %>"
                placeholder="Search news..."
            >

            <button type="submit">
                Search
            </button>

        </form>

        <br>

        <% if(query){ %>

            <p>
                Results for:
                <strong><%= query %></strong>
            </p>

        <% } %>

        <% if(results.length === 0){ %>

            <p>
                No results found.
            </p>

        <% } %>

        <div class="latest-posts-list">

            <% results.forEach(post => { %>

                <article class="horizontal-post-card">

                    <a
                        href="/article/<%= post.slug %>"
                        class="horizontal-post-link"
                    >

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="horizontal-post-image"
                        >

                        <div class="horizontal-post-content">

                            <span class="post-category">
                                <%= post.category %>
                            </span>

                            <h2 class="post-title">
                                <%= post.title %>
                            </h2>

                            <p class="post-summary">
                                <%= post.excerpt %>
                            </p>

                        </div>

                    </a>

                </article>

            <% }) %>

        </div>

      </div>

      <aside class="sidebar" aria-label="More articles">
          <%- include('partials/sidebar', { sidebarData: typeof sidebarData !== "undefined" ? sidebarData : null }) %>
      </aside>

    </div>

</main>

<%- include("partials/footer") %>

</body>
</html>