<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <%- include('partials/seo', {
        title: 'SocialsForce - News, Trends and Digital Culture',
        description: 'Discover the latest news, tech trends, gaming, AI and internet culture on SocialsForce.',
        canonicalUrl: 'https://socialsforce.com/',
        ogImage: '/images/logo.png',
        pageType: 'website'
    }) %>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="icon" href="/images/logo.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-W0JR7YHY4C"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-W0JR7YHY4C');
</script>
<body>

<main id="homepage">
    <%- include("partials/header") %>

    <!-- FEATURED ARTICLE -->

    <% if (featuredPost) { %>

    <section id="featured-article-section">

        <div class="content-container">

            <article class="featured-article-card">

                <a
                    href="/article/<%= featuredPost.slug %>"
                    class="featured-article-link"
                >

                    <% if (featuredPost.image) { %>

                    <img
                        src="<%= featuredPost.image %>"
                        alt="<%= featuredPost.title %>"
                        class="featured-article-image"
                    >

                    <% } %>

                    <div class="featured-article-content">

                        <% if (featuredPost.category) { %>

                        <span class="article-category">
                            <%= featuredPost.category %>
                        </span>

                        <% } %>

                        <h1 class="featured-article-title">
                            <%= featuredPost.title %>
                        </h1>

                        <% if (featuredPost.excerpt) { %>

                        <p class="featured-article-summary">
                            <%= featuredPost.excerpt %>
                        </p>

                        <% } %>

                        <div class="article-meta">

                            <span>
                                <%= new Date(featuredPost.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </div>

                </a>

            </article>

        </div>

    </section>

    <% } %>


    <!-- TRENDING -->

    <% if (trendingPosts.length > 0) { %>

    <section id="trending-posts-section">

        <div class="content-container">

            <div class="section-header">

                <h2 class="section-title">
                    Trending
                </h2>

                <a href="/trending" class="section-link">
                    View all
                </a>

            </div>


            <div class="trending-posts-grid">

                <% trendingPosts.forEach(post => { %>

                <article class="post-card card-linked">

                    <div class="post-card-inner">

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="post-image"
                        >

                        <% } %>

                        <div class="post-content">

                            <% if (post.category) { %>

                            <a href="/category/<%= encodeURIComponent(post.category.toLowerCase()) %>" class="post-category card-category-link">
                                <%= post.category %>
                            </a>

                            <% } %>

                            <h3 class="post-title">
                                <a href="/article/<%= post.slug %>" class="stretched-link"><%= post.title %></a>
                            </h3>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </div>

                </article>

                <% }) %>

            </div>

        </div>

    </section>

    <% } %>


    <!-- LATEST NEWS -->

    <% if (latestPosts.length > 0) { %>

    <section id="latest-posts-section">

        <div class="content-container">

            <div class="section-header">

                <h2 class="section-title">
                    Latest News
                </h2>

                <a href="/recent" class="section-link">
                    View all
                </a>

            </div>


            <div class="latest-posts-list">

                <% latestPosts.forEach(post => { %>

                <article class="horizontal-post-card card-linked">

                    <div class="horizontal-post-link">

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="horizontal-post-image"
                        >

                        <% } %>

                        <div class="horizontal-post-content">

                            <% if (post.category) { %>

                            <a href="/category/<%= encodeURIComponent(post.category.toLowerCase()) %>" class="post-category card-category-link">
                                <%= post.category %>
                            </a>

                            <% } %>

                            <h3 class="post-title">
                                <a href="/article/<%= post.slug %>" class="stretched-link"><%= post.title %></a>
                            </h3>

                            <% if (post.excerpt) { %>

                            <p class="post-summary">
                                <%= post.excerpt %>
                            </p>

                            <% } %>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </div>

                </article>

                <% }) %>

            </div>

        </div>

    </section>

    <% } %>


    <!-- FOR YOU -->

    <section class="foryou-section" id="foryou-section" aria-labelledby="foryou-title">

        <div class="content-container">

            <div class="section-header">

                <h2 id="foryou-title" class="section-title">
                    For You
                </h2>

                <span class="section-subtitle">
                    Recommended based on your interests
                </span>

            </div>

            <div class="foryou-grid" id="foryou-grid">
                <!-- cargado por JS -->
            </div>

        </div>

    </section>


    <!-- RANDOM CATEGORY -->

    <% if (randomCategoryPosts.length > 0) { %>

    <section id="random-category-section" class="category-post-section">

        <div class="content-container">

            <div class="section-header">

                <h2 class="section-title">
                    <%= randomCategory %>
                </h2>

                <a
                    href="/category/<%= randomCategory.toLowerCase() %>"
                    class="section-link"
                >
                    View all
                </a>

            </div>


            <div class="category-post-grid">

                <% randomCategoryPosts.forEach(post => { %>

                <article class="post-card">

                    <a href="/article/<%= post.slug %>">

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="post-image"
                        >

                        <% } %>

                        <div class="post-content">

                            <h3 class="post-title">
                                <%= post.title %>
                            </h3>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </a>

                </article>

                <% }) %>

            </div>

        </div>

    </section>

    <% } %>


</main>
<%- include("partials/footer") %>

<script src="/js/main.js"></script>

<!-- FOR YOU: recomendaciones -->
<script>
(function () {
    function esc(str) {
        return String(str == null ? '' : str).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    var cats = [], seen = [];
    try {
        cats = JSON.parse(localStorage.getItem('sf_cats') || '[]');
        seen = JSON.parse(localStorage.getItem('sf_seen') || '[]');
    } catch (e) {}

    var counts = cats.reduce(function (acc, c) { acc[c] = (acc[c] || 0) + 1; return acc; }, {});
    var topCats = Object.keys(counts)
        .sort(function (a, b) { return counts[b] - counts[a]; })
        .slice(0, 3);

    var params = new URLSearchParams();
    if (topCats.length) params.set('cats', topCats.join(','));
    if (seen.length) params.set('exclude', seen.slice(-20).join(','));

    fetch('/api/para-ti?' + params.toString())
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data || !data.success || !data.posts || !data.posts.length) return;

            var grid = document.getElementById('foryou-grid');

            grid.innerHTML = data.posts.map(function (p) {
                var excerpt = String(p.excerpt || '');
                if (excerpt.length > 100) excerpt = excerpt.substring(0, 100).trim() + '…';

                return '<article class="foryou-card card-linked">' +
                    (p.image ? '<img src="' + esc(p.image) + '" alt="' + esc(p.title) + '" loading="lazy">' : '') +
                    '<div class="foryou-card-body">' +
                        (p.category ? '<a href="/category/' + encodeURIComponent(String(p.category).toLowerCase()) + '" class="card-category card-category-link">' + esc(p.category) + '</a>' : '') +
                        '<h3><a href="/article/' + encodeURIComponent(p.slug) + '" class="stretched-link">' + esc(p.title) + '</a></h3>' +
                        (excerpt ? '<p>' + esc(excerpt) + '</p>' : '') +
                    '</div>' +
                '</article>';
            }).join('');

            document.getElementById('foryou-section').style.display = 'block';
        })
        .catch(function () {});
})();
</script>

</body>
</html>