<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <%- include('partials/seo', {
        title: 'SocialsForce - News, Trends and Digital Culture',
        description: 'Discover the latest news, tech trends, gaming, AI and internet culture on SocialsForce.',
        canonicalUrl: 'https://socialsforce.com/',
        ogImage: '/images/logo.png',
        pageType: 'website'
    }) %>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/home-feed.css">
    <link rel="stylesheet" href="/css/home-extras.css">
    <link rel="icon" href="/images/logo.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

</head>
<%- include("partials/analytics") %>
<body>

<main id="homepage">
    <%- include("partials/header") %>

    <!-- FEATURED ARTICLE -->

    <% if (featuredPost) { %>

    <section id="featured-article-section">

        <div class="content-container">

            <article class="featured-article-card">

                <a
                    href="/article/<%= featuredPost.slug %>"
                    class="featured-article-link"
                >

                    <% if (featuredPost.image) { %>

                    <img
                        src="<%= featuredPost.image %>"
                        alt="<%= featuredPost.title %>"
                        class="featured-article-image"
                    >

                    <% } %>

                    <div class="featured-article-content">

                        <% if (featuredPost.category) { %>

                        <span class="article-category">
                            <%= featuredPost.category %>
                        </span>

                        <% } %>

                        <h1 class="featured-article-title">
                            <%= featuredPost.title %>
                        </h1>

                        <% if (featuredPost.excerpt) { %>

                        <p class="featured-article-summary">
                            <%= featuredPost.excerpt %>
                        </p>

                        <% } %>

                        <div class="article-meta">

                            <span>
                                <%= new Date(featuredPost.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </div>

                </a>

            </article>

        </div>

    </section>

    <% } %>


    <%- include('partials/home-extras', { part: 'top', x: typeof homeExtras !== 'undefined' ? homeExtras : null }) %>

    <!-- TRENDING -->

    <% if (trendingPosts.length > 0) { %>

    <section id="trending-posts-section">

        <div class="content-container hx-trend-split">
            <div class="hx-trend-main">

            <div class="section-header">

                <h2 class="section-title">
                    Trending
                </h2>

                <a href="/trending" class="section-link">
                    View all
                </a>

            </div>


            <div class="trending-posts-grid">

                <% trendingPosts.forEach((post, i) => { %>

                <article class="post-card card-linked" data-rec-pl="home" data-rec-pos="<%= i %>" data-pid="<%= post.id %>">

                    <div class="post-card-inner">

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="post-image"
                        >

                        <% } %>

                        <div class="post-content">

                            <% if (post.category) { %>

                            <a href="/category/<%= encodeURIComponent(post.category.toLowerCase()) %>" class="post-category card-category-link">
                                <%= post.category %>
                            </a>

                            <% } %>

                            <h3 class="post-title">
                                <a href="/article/<%= post.slug %>" class="stretched-link"><%= post.title %></a>
                            </h3>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </div>

                </article>

                <% }) %>

            </div>

        </div>
            <%- include('partials/home-extras', { part: 'intro', x: typeof homeExtras !== 'undefined' ? homeExtras : null }) %>
        </div>

    </section>

    <% } %>

    <%- include('partials/home-extras', { part: 'carousel', x: typeof homeExtras !== 'undefined' ? homeExtras : null }) %>


    <!-- LATEST NEWS -->

    <% if (latestPosts.length > 0) { %>

    <section id="latest-posts-section">

        <div class="content-container home-with-sidebar">
            <div class="home-main">

            <div class="section-header">

                <h2 class="section-title">
                    Latest News
                </h2>

                <a href="/recent" class="section-link">
                    View all
                </a>

            </div>


            <div class="latest-posts-list">

                <% latestPosts.forEach(post => { %>

                <article class="horizontal-post-card card-linked">

                    <div class="horizontal-post-link">

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="horizontal-post-image"
                        >

                        <% } %>

                        <div class="horizontal-post-content">

                            <% if (post.category) { %>

                            <a href="/category/<%= encodeURIComponent(post.category.toLowerCase()) %>" class="post-category card-category-link">
                                <%= post.category %>
                            </a>

                            <% } %>

                            <h3 class="post-title">
                                <a href="/article/<%= post.slug %>" class="stretched-link"><%= post.title %></a>
                            </h3>

                            <% if (post.excerpt) { %>

                            <p class="post-summary">
                                <%= post.excerpt %>
                            </p>

                            <% } %>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </div>

                </article>

                <% }) %>

            </div>

            <%- include('partials/home-extras', { part: 'latest', x: typeof homeExtras !== 'undefined' ? homeExtras : null }) %>
        </div>
            <%- include('partials/home-sidebar') %>
        </div>

    </section>

    <% } %>


    <!-- FOR YOU -->

    <section class="foryou-section" id="foryou-section" aria-labelledby="foryou-title">

        <div class="content-container">

            <div class="section-header">

                <h2 id="foryou-title" class="section-title">
                    For You
                </h2>

                <a href="/for-you" class="section-link" rel="nofollow">
                    See more →
                </a>

            </div>

            <div class="foryou-grid" id="foryou-grid" data-foryou data-size="6">
                <!-- cargado por JS -->
            </div>

        </div>

    </section>

    <% if (typeof popularTopics !== "undefined" && popularTopics && popularTopics.length) { %>
    <section class="popular-topics-section" aria-labelledby="topics-title">
        <div class="content-container">
            <div class="section-header">
                <h2 id="topics-title" class="section-title">Popular Topics</h2>
            </div>
            <div class="sidebar-pills">
                <% popularTopics.forEach(t => { %>
                <a href="/topic/<%= t.slug %>" class="sidebar-pill"><%= t.name %></a>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>


    <!-- RANDOM CATEGORY -->

    <% if (randomCategoryPosts.length > 0) { %>

    <section id="random-category-section" class="category-post-section">

        <div class="content-container">

            <div class="section-header">

                <h2 class="section-title">
                    <%= randomCategory %>
                </h2>

                <a
                    href="/category/<%= randomCategory.toLowerCase() %>"
                    class="section-link"
                >
                    View all
                </a>

            </div>


            <div class="category-post-grid">

                <% randomCategoryPosts.forEach(post => { %>

                <article class="post-card">

                    <a href="/article/<%= post.slug %>">

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="post-image"
                        >

                        <% } %>

                        <div class="post-content">

                            <h3 class="post-title">
                                <%= post.title %>
                            </h3>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </a>

                </article>

                <% }) %>

            </div>

        </div>

    </section>

    <% } %>


    <%- include('partials/home-extras', { part: 'bottom', x: typeof homeExtras !== 'undefined' ? homeExtras : null }) %>
</main>
<%- include("partials/footer") %>

<script src="/js/main.js"></script>

<script src="/js/foryou.js" defer></script>
<script src="/js/home-extras.js" defer></script>

</body>
</html>