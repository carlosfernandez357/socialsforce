<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SocialsForce - News, Trends and Digital Culture</title>

    <meta
        name="description"
        content="SocialsForce brings you the latest news, trends, technology, gaming, AI and internet culture."
    >

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >
</head>

<body>

<main id="homepage">
    <%- include("partials/header") %>

    <!-- FEATURED ARTICLE -->

    <% if (featuredPost) { %>

    <section id="featured-article-section">

        <div class="content-container">

            <article class="featured-article-card">

                <a
                    href="/article/<%= featuredPost.slug %>"
                    class="featured-article-link"
                >

                    <% if (featuredPost.image) { %>

                    <img
                        src="<%= featuredPost.image %>"
                        alt="<%= featuredPost.title %>"
                        class="featured-article-image"
                    >

                    <% } %>

                    <div class="featured-article-content">

                        <% if (featuredPost.category) { %>

                        <span class="article-category">
                            <%= featuredPost.category %>
                        </span>

                        <% } %>

                        <h1 class="featured-article-title">
                            <%= featuredPost.title %>
                        </h1>

                        <% if (featuredPost.excerpt) { %>

                        <p class="featured-article-summary">
                            <%= featuredPost.excerpt %>
                        </p>

                        <% } %>

                        <div class="article-meta">

                            <span>
                                <%= new Date(featuredPost.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </div>

                </a>

            </article>

        </div>

    </section>

    <% } %>


    <!-- TRENDING -->

    <% if (trendingPosts.length > 0) { %>

    <section id="trending-posts-section">

        <div class="content-container">

            <div class="section-header">

                <h2 class="section-title">
                    Trending
                </h2>

                <a href="/trending" class="section-link">
                    View all
                </a>

            </div>


            <div class="trending-posts-grid">

                <% trendingPosts.forEach(post => { %>

                <article class="post-card">

                    <a href="/article/<%= post.slug %>">

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="post-image"
                        >

                        <% } %>

                        <div class="post-content">

                            <% if (post.category) { %>

                            <span class="post-category">
                                <%= post.category %>
                            </span>

                            <% } %>

                            <h3 class="post-title">
                                <%= post.title %>
                            </h3>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </a>

                </article>

                <% }) %>

            </div>

        </div>

    </section>

    <% } %>


    <!-- LATEST NEWS -->

    <% if (latestPosts.length > 0) { %>

    <section id="latest-posts-section">

        <div class="content-container">

            <div class="section-header">

                <h2 class="section-title">
                    Latest News
                </h2>

                <a href="/recent" class="section-link">
                    View all
                </a>

            </div>


            <div class="latest-posts-list">

                <% latestPosts.forEach(post => { %>

                <article class="horizontal-post-card">

                    <a
                        href="/article/<%= post.slug %>"
                        class="horizontal-post-link"
                    >

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="horizontal-post-image"
                        >

                        <% } %>

                        <div class="horizontal-post-content">

                            <% if (post.category) { %>

                            <span class="post-category">
                                <%= post.category %>
                            </span>

                            <% } %>

                            <h3 class="post-title">
                                <%= post.title %>
                            </h3>

                            <% if (post.excerpt) { %>

                            <p class="post-summary">
                                <%= post.excerpt %>
                            </p>

                            <% } %>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </a>

                </article>

                <% }) %>

            </div>

        </div>

    </section>

    <% } %>


    <!-- RANDOM CATEGORY -->

    <% if (randomCategoryPosts.length > 0) { %>

    <section id="random-category-section" class="category-post-section">

        <div class="content-container">

            <div class="section-header">

                <h2 class="section-title">
                    <%= randomCategory %>
                </h2>

                <a
                    href="/category/<%= randomCategory.toLowerCase() %>"
                    class="section-link"
                >
                    View all
                </a>

            </div>


            <div class="category-post-grid">

                <% randomCategoryPosts.forEach(post => { %>

                <article class="post-card">

                    <a href="/article/<%= post.slug %>">

                        <% if (post.image) { %>

                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="post-image"
                        >

                        <% } %>

                        <div class="post-content">

                            <h3 class="post-title">
                                <%= post.title %>
                            </h3>

                            <span class="post-date">
                                <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric"
                                }) %>
                            </span>

                        </div>

                    </a>

                </article>

                <% }) %>

            </div>

        </div>

    </section>

    <% } %>


</main>
<%- include("partials/footer") %>

<script src="/js/main.js"></script>

</body>
</html>