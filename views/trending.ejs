<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" href="/images/logo.png" type="image/png">
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Trending - SocialsForce</title>

    <meta
        name="description"
        content="Discover the most viewed and trending stories on SocialsForce."
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >


    <title>Trending News | SocialsForce</title>

    <meta name="description"
        content="The most viewed and trending stories right now.">

    <link rel="canonical"
        href="https://socialsforce.com/trending">


</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-W0JR7YHY4C"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-W0JR7YHY4C');
</script>

<body>


    <%- include("partials/header") %>


    <main id="trending-page">


        <section class="listing-page-section">

            <div class="content-container">


                <div class="listing-page-header">

                    <span class="listing-page-label">
                        SocialsForce
                    </span>

                    <h1 class="listing-page-title">
                        Trending
                    </h1>

                    <p class="listing-page-description">
                        Discover the stories everyone is reading right now.
                    </p>

                </div>


                <% if (posts && posts.length > 0) { %>

                <div class="listing-posts-grid">

                    <% posts.forEach(post => { %>

                    <article class="post-card">

                        <a href="/article/<%= post.slug %>">


                            <% if (post.image) { %>

                            <img
                                src="<%= post.image %>"
                                alt="<%= post.title %>"
                                class="post-image"
                            >

                            <% } %>


                            <div class="post-content">


                                <% if (post.category) { %>

                                <span class="post-category">
                                    <%= post.category %>
                                </span>

                                <% } %>


                                <h2 class="post-title">
                                    <%= post.title %>
                                </h2>


                                <% if (post.excerpt) { %>

                                <p class="post-summary">
                                    <%= post.excerpt %>
                                </p>

                                <% } %>


                                <div class="post-meta">

                                    <span class="post-date">

                                        <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                            year: "numeric",
                                            month: "long",
                                            day: "numeric"
                                        }) %>

                                    </span>


                                    <span class="post-views">
                                        <%= post.views.toLocaleString("en-US") %> views
                                    </span>

                                </div>


                            </div>

                        </a>

                    </article>

                    <% }) %>

                </div>


                <% } else { %>

                <div class="empty-posts">

                    <h2>
                        No trending news
                    </h2>

                    <p>
                        There are no trending articles yet.
                    </p>

                </div>

                <% } %>


            </div>

        </section>


    </main>


    <%- include("partials/footer") %>


    <script src="/js/main.js"></script>


</body>

</html>