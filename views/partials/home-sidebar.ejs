<aside class="home-sidebar" aria-label="Home sidebar">
    <a href="/feed" class="hs-feed-cta">
        <span class="hs-feed-icon">▶</span>
        <span><strong>Scroll mode</strong><small>One story at a time, TikTok style</small></span>
    </a>

    <% if (typeof recentPosts !== "undefined" && recentPosts.length) { %>
    <section class="hs-box">
        <h3 class="hs-title"><span class="hs-live"></span>Just in</h3>
        <ol class="hs-timeline">
            <% recentPosts.forEach(p => { const m = Math.max(1, Math.round((Date.now() - new Date(p.published_at)) / 60000)); %>
            <li>
                <time><%= m < 60 ? m + " min" : m < 1440 ? Math.round(m / 60) + " h" : Math.round(m / 1440) + " d" %></time>
                <a href="/article/<%= p.slug %>"><%= p.title %></a>
                <% if (p.category) { %><span class="hs-cat"><%= p.category %></span><% } %>
            </li>
            <% }) %>
        </ol>
        <a href="/recent" class="hs-more">All recent news →</a>
    </section>
    <% } %>

    <% if (typeof mostRead !== "undefined" && mostRead.length) { %>
    <section class="hs-box">
        <h3 class="hs-title">Most read this month</h3>
        <ol class="hs-ranking">
            <% mostRead.forEach((p, i) => { %>
            <li><span class="hs-num"><%= i + 1 %></span><a href="/article/<%= p.slug %>"><%= p.title %></a></li>
            <% }) %>
        </ol>
    </section>
    <% } %>

    <section class="hs-box hs-foryou">
        <h3 class="hs-title">Made for you</h3>
        <p>Recommendations based on what you read.</p>
        <a href="/for-you" class="hs-btn">Open For You</a>
    </section>
</aside>
