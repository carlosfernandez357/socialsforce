<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Categories - SocialsForce</title>

    <meta
        name="description"
        content="Explore all SocialsForce categories and discover the latest stories in AI, technology, gaming, internet and more."
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >


    <title><%= category %> News | SocialsForce</title>

    <meta name="description"
        content="Latest <%= category %> news, trends and updates.">

    <link rel="canonical"
        href="https://socialsforce.com/category/<%= category.toLowerCase() %>">

    </head>


<body>


    <%- include("partials/header") %>


    <main id="categories-page">


        <section class="listing-page-section">

            <div class="content-container">


                <div class="listing-page-header">

                    <span class="listing-page-label">
                        SocialsForce
                    </span>

                    <h1 class="listing-page-title">
                        Categories
                    </h1>

                    <p class="listing-page-description">
                        Explore the latest stories across all SocialsForce categories.
                    </p>

                </div>


                <% categories.forEach(category => { %>

                <section class="category-slider-section">


                    <div class="section-header">

                        <h2 class="section-title">
                            <%= category.name %>
                        </h2>

                        <a
                            href="/category/<%= category.slug %>"
                            class="section-link"
                        >
                            View all
                        </a>

                    </div>


                    <% if (category.posts.length > 0) { %>

                    <div class="category-slider">

                        <% category.posts.forEach(post => { %>

                        <article class="post-card category-slider-card">

                            <a
                                href="/article/<%= post.slug %>"
                            >


                                <% if (post.image) { %>

                                <img
                                    src="<%= post.image %>"
                                    alt="<%= post.title %>"
                                    class="post-image"
                                >

                                <% } %>


                                <div class="post-content">


                                    <% if (post.category) { %>

                                    <span class="post-category">
                                        <%= post.category %>
                                    </span>

                                    <% } %>


                                    <h3 class="post-title">
                                        <%= post.title %>
                                    </h3>


                                    <span class="post-date">

                                        <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                            year: "numeric",
                                            month: "long",
                                            day: "numeric"
                                        }) %>

                                    </span>


                                </div>

                            </a>

                        </article>

                        <% }) %>

                    </div>

                    <% } else { %>

                    <p class="category-empty">
                        No articles available yet.
                    </p>

                    <% } %>


                </section>

                <% }) %>


            </div>

        </section>


    </main>


    <%- include("partials/footer") %>


    <script src="/js/main.js"></script>


</body>

</html>