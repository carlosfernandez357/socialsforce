<%
const categorySlug = post.category ? encodeURIComponent(post.category.toLowerCase()) : null;
const crumbTitle = String(post.title || "").length > 50 ? String(post.title).slice(0, 50).trim() + "…" : post.title;
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/logo.png" type="image/png">

    <%- include('partials/seo', {
        title: post.title + ' - SocialsForce',
        description: post.excerpt || post.title,
        canonicalUrl: 'https://socialsforce.com/article/' + post.slug,
        ogImage: post.image,
        pageType: 'article',
        post: post
    }) %>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/sidebar.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <%- include("partials/analytics") %>
</head>

<body>


    <%- include("partials/header") %>


    <main id="article-page">


        <!-- BREADCRUMB -->

        <div class="content-container">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <span class="breadcrumb-separator" aria-hidden="true">›</span>
                <% if (post.category) { %>
                <a href="/category/<%= categorySlug %>"><%= post.category %></a>
                <span class="breadcrumb-separator" aria-hidden="true">›</span>
                <% } %>
                <span class="breadcrumb-current" aria-current="page" title="<%= post.title %>"><%= crumbTitle %></span>
            </nav>
        </div>


        <!-- ARTICLE HEADER -->

        <section class="article-header-section">

            <div class="content-container">

                <header class="article-header">

                    <% if (post.category) { %>

                    <a
                        href="/category/<%= categorySlug %>"
                        class="article-category"
                    >
                        <%= post.category %>
                    </a>

                    <% } %>


                    <h1 class="article-title">
                        <%= post.title %>
                    </h1>


                    <% if (post.excerpt) { %>

                    <p class="article-excerpt">
                        <%= post.excerpt %>
                    </p>

                    <% } %>


                    <div class="article-byline">
                        <img src="/images/logo.png" alt="SocialsForce Editorial" class="byline-avatar" width="40" height="40">
                        <div class="byline-info">
                            <span class="byline-author">SocialsForce Editorial</span>
                            <span class="byline-meta">
                                <% if (post.published_at) { %><time datetime="<%= new Date(post.published_at).toISOString() %>"><%= new Date(post.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></time><% } %>
                                <% if (typeof readingTime !== "undefined" && readingTime) { %> · <%= readingTime %> min read<% } %>
                                <% if (post.views !== undefined && post.views !== null) { %> · <%= Number(post.views).toLocaleString('en-US') %> views<% } %>
                            </span>
                        </div>
                    </div>

                </header>

            </div>

        </section>



        <!-- CONTENT + SIDEBAR -->

        <section class="article-content-section">

            <div class="content-container content-sidebar-layout">

                <div class="article-main">

                    <% if (post.image) { %>

                    <figure class="article-image-wrapper">
                        <img
                            src="<%= post.image %>"
                            alt="<%= post.title %>"
                            class="article-hero-img"
                            fetchpriority="high"
                        >
                    </figure>

                    <% } %>

                    <article class="article-content" data-track-pid="<%= post.id %>" data-track-cat="<%= post.category || '' %>">

                        <%- post.content %>

                    </article>

                    <% if (typeof postTopics !== "undefined" && postTopics && postTopics.length) { %>
                    <nav class="article-topics" aria-label="Topics">
                        <span class="article-topics-label">Topics:</span>
                        <% postTopics.slice(0, 8).forEach(t => { %>
                        <a href="/topic/<%= t.slug %>" class="sidebar-pill"><%= t.name %></a>
                        <% }) %>
                    </nav>
                    <% } %>


                    <!-- RELATED CONTENT -->

                    <% if (relatedPosts && relatedPosts.length > 0) { %>

                    <section id="related-content-section" aria-labelledby="related-title">

                        <div class="section-header">

                            <h2 id="related-title" class="section-title">
                                Related Content
                            </h2>

                            <% if (post.category) { %>

                            <a
                                href="/category/<%= categorySlug %>"
                                class="section-link"
                            >
                                More in <%= post.category %>
                            </a>

                            <% } %>

                        </div>


                        <div class="related-posts-grid">

                            <% relatedPosts.forEach((related, i) => { %>

                            <article class="post-card" data-rec-pl="related" data-rec-pos="<%= i %>" data-pid="<%= related.id %>">

                                <a href="/article/<%= related.slug %>" tabindex="-1" aria-hidden="true">
                                    <img
                                        src="<%= related.image || '/images/noimage.jpg' %>"
                                        alt="<%= related.title %>"
                                        class="post-image"
                                        loading="lazy"
                                    >
                                </a>

                                <div class="post-content">

                                    <% if (related.category) { %>

                                    <a
                                        href="/category/<%= encodeURIComponent(related.category.toLowerCase()) %>"
                                        class="post-category post-category-link"
                                    >
                                        <%= related.category %>
                                    </a>

                                    <% } %>

                                    <a href="/article/<%= related.slug %>" class="post-card-title-link">
                                        <h3 class="post-title">
                                            <%= related.title %>
                                        </h3>
                                    </a>

                                    <% if (related.excerpt) { %>

                                    <p class="post-excerpt-short">
                                        <%= related.excerpt %>
                                    </p>

                                    <% } %>

                                    <% if (related.published_at) { %>

                                    <time
                                        class="post-date"
                                        datetime="<%= new Date(related.published_at).toISOString() %>"
                                    >
                                        <%= new Date(related.published_at).toLocaleDateString("en-US", {
                                            year: "numeric",
                                            month: "long",
                                            day: "numeric"
                                        }) %>
                                    </time>

                                    <% } %>

                                </div>

                            </article>

                            <% }) %>

                        </div>

                    </section>

                    <% } %>


                    <!-- RANDOM BACK NAVIGATION -->

                    <div class="article-navigation">

                        <a
                            href="<%= backDestination.url %>"
                            class="article-back-link"
                        >
                            ← <%= backDestination.label %>
                        </a>

                    </div>

                </div>


                <aside class="sidebar" aria-label="More articles">
                    <%- include('partials/sidebar', { sidebarData: typeof sidebarData !== "undefined" ? sidebarData : null }) %>
                </aside>

            </div>

        </section>


    </main>


    <%- include("partials/footer") %>


    <script src="/js/main.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>


</body>

</html>
