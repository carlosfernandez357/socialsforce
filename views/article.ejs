<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" href="/images/logo.png" type="image/png">
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= post.title %> - SocialsForce
    </title>

    <meta
        name="description"
        content="<%= post.excerpt || post.title %>"
    >

    <meta
        property="og:title"
        content="<%= post.title %>"
    >

    <meta
        property="og:description"
        content="<%= post.excerpt || post.title %>"
    >

    <% if (post.image) { %>

    <meta
        property="og:image"
        content="<%= post.image %>"
    >

    <% } %>

    <meta
        property="og:type"
        content="article"
    >

    <meta
        property="og:site_name"
        content="SocialsForce"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >




    <meta name="description"
        content="<%= post.excerpt %>">

    <link rel="canonical"
        href="https://socialsforce.com/article/<%= post.slug %>">

    <meta property="og:type"
        content="article">

    <meta property="og:title"
        content="<%= post.title %>">

    <meta property="og:description"
        content="<%= post.excerpt %>">


    <meta property="article:published_time"
        content="<%= post.created_at %>">

    <meta property="article:section"
        content="<%= post.category %>">

    <script type="application/ld+json">
    {
    "@context":"https://schema.org",
    "@type":"NewsArticle",
    "headline":"<%= post.title %>",
    "description":"<%= post.excerpt %>",
    "image":["<%= post.image %>"],
    "datePublished":"<%= post.created_at %>",
    "dateModified":"<%= post.updated_at %>",
    "author":{
    "@type":"Organization",
    "name":"SocialsForce"
    },
    "publisher":{
    "@type":"Organization",
    "name":"SocialsForce"
    }
    }
    </script>




</head>



<body>


    <%- include("partials/header") %>


    <main id="article-page">


        <!-- ARTICLE HEADER -->

        <section class="article-header-section">

            <div class="content-container">

                <div class="article-header">

                    <% if (post.category) { %>

                    <a
                        href="/category/<%= post.category.toLowerCase() %>"
                        class="article-category"
                    >
                        <%= post.category %>
                    </a>

                    <% } %>


                    <h1 class="article-title">
                        <%= post.title %>
                    </h1>


                    <% if (post.excerpt) { %>

                    <p class="article-excerpt">
                        <%= post.excerpt %>
                    </p>

                    <% } %>


                    <div class="article-meta">

                        <% if (post.published_at) { %>

                        <time
                            datetime="<%= post.published_at.toISOString() %>"
                        >
                            <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric"
                            }) %>
                        </time>

                        <% } %>


                        <% if (post.views !== undefined) { %>

                        <span class="article-views">
                            <%= post.views.toLocaleString("en-US") %> views
                        </span>

                        <% } %>

                    </div>

                </div>

            </div>

        </section>



        <!-- ARTICLE IMAGE -->

        <% if (post.image) { %>

        <section class="article-image-section">

            <div class="content-container">

                <figure class="article-image-wrapper">

                    <img
                        src="<%= post.image %>"
                        alt="<%= post.title %>"
                        class="article-main-image"
                    >

                </figure>

            </div>

        </section>

        <% } %>



        <!-- ARTICLE CONTENT -->

        <section class="article-content-section">

            <div class="content-container">

                <article class="article-content">

                    <%- post.content %>

                </article>


            <!-- RELATED CONTENT -->

            <% if (relatedPosts && relatedPosts.length > 0) { %>

            <section id="related-content-section">

                <div class="content-container">

                    <div class="section-header">

                        <h2 class="section-title">
                            Related Content
                        </h2>

                        <a
                            href="/category/<%= post.category.toLowerCase() %>"
                            class="section-link"
                        >
                            View all
                        </a>

                    </div>


                    <div class="related-posts-grid">

                        <% relatedPosts.forEach(post => { %>

                        <article class="post-card">

                            <a href="/article/<%= post.slug %>">

                                <% if (post.image) { %>

                                <img
                                    src="<%= post.image %>"
                                    alt="<%= post.title %>"
                                    class="post-image"
                                >

                                <% } %>

                                <div class="post-content">

                                    <% if (post.category) { %>

                                    <span class="post-category">
                                        <%= post.category %>
                                    </span>

                                    <% } %>

                                    <h3 class="post-title">
                                        <%= post.title %>
                                    </h3>

                                    <span class="post-date">

                                        <%= new Date(post.published_at).toLocaleDateString("en-US", {
                                            year: "numeric",
                                            month: "long",
                                            day: "numeric"
                                        }) %>

                                    </span>

                                </div>

                            </a>

                        </article>

                        <% }) %>

                    </div>

                </div>

            </section>

            <% } %>


            <!-- RANDOM BACK NAVIGATION -->

            <section class="article-navigation-section">

                <div class="content-container">

                    <div class="article-navigation">

                        <a
                            href="<%= backDestination.url %>"
                            class="article-back-link"
                        >
                            ← <%= backDestination.label %>
                        </a>

                    </div>

                </div>

            </section>



            </div>

        </section>


    </main>


    <%- include("partials/footer") %>


    <script src="/js/main.js"></script>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

</body>

</html>