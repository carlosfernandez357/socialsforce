<%- include("header") %>
<%- include("sidebar") %>

<main class="admin-main">

    <div class="admin-page-header">
        <div>
            <h1>Dashboard</h1>
            <p>Overview of your SocialsForce platform.</p>
        </div>

        <a href="/admin/create-article" class="admin-primary-button">
            + Create article
        </a>
    </div>

    <!-- Statistics -->

    <div class="admin-stats-grid">

        <div class="admin-stat-card">
            <span class="admin-stat-label">Total views</span>
            <strong class="admin-stat-value">
                <%= Number(stats.totalViews || 0).toLocaleString() %>
            </strong>
            <span class="admin-stat-description">All article views</span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Total articles</span>
            <strong class="admin-stat-value">
                <%= stats.totalPosts || 0 %>
            </strong>
            <span class="admin-stat-description">Published articles</span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Categories</span>
            <strong class="admin-stat-value">
                <%= stats.totalCategories || 0 %>
            </strong>
            <span class="admin-stat-description">Active categories</span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Published today</span>
            <strong class="admin-stat-value">
                <%= stats.todayPosts || 0 %>
            </strong>
            <span class="admin-stat-description">Articles published today</span>
        </div>

    </div>

    <!-- Main dashboard -->

    <div class="admin-dashboard-grid">

        <!-- Latest posts -->

        <section class="admin-card admin-dashboard-articles">

            <div class="admin-card-header">
                <div>
                    <h2>Latest posts</h2>
                    <p>Recently published articles.</p>
                </div>

                <a href="/admin/articles" class="admin-card-link">
                    View all
                </a>
            </div>

            <div class="admin-article-list">

                <% latestPosts.forEach(post => { %>

                    <div class="admin-article-row">

                        <div class="admin-article-main">

                            <div class="admin-article-thumbnail">

                                <% if (post.image) { %>

                                    <img
                                        src="<%= post.image %>"
                                        alt="<%= post.title %>"
                                    >

                                <% } else { %>

                                    <span>SF</span>

                                <% } %>

                            </div>

                            <div class="admin-article-details">

                                <a
                                    href="/article/<%= post.slug %>"
                                    target="_blank"
                                    class="admin-article-title"
                                >
                                    <%= post.title %>
                                </a>

                                <div class="admin-article-meta">

                                    <span>
                                        <%= post.category || "Uncategorized" %>
                                    </span>

                                    <span>•</span>

                                    <span>
                                        <%= Number(post.views || 0).toLocaleString() %> views
                                    </span>

                                    <% if (post.published_at) { %>

                                        <span>•</span>

                                        <span>
                                            <%= new Date(post.published_at).toLocaleDateString("en-GB") %>
                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                        <div class="admin-article-status">

                            <% if (post.indexed === true) { %>

                                <span class="index-status indexed">
                                    <span></span>
                                    Indexed
                                </span>

                            <% } else { %>

                                <span class="index-status not-indexed">
                                    <span></span>
                                    Not indexed
                                </span>

                            <% } %>

                        </div>

                        <div class="admin-article-actions">

                            <a
                                href="/article/<%= post.slug %>"
                                target="_blank"
                                class="admin-action-button"
                            >
                                Visit
                            </a>

                            <form
                                action="/admin/articles/<%= post.id %>/delete"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this article?');"
                            >

                                <button
                                    type="submit"
                                    class="admin-action-button delete"
                                >
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

                <% if (latestPosts.length === 0) { %>

                    <div class="admin-empty">
                        No articles found.
                    </div>

                <% } %>

            </div>

        </section>

        <!-- Top posts -->

        <section class="admin-card">

            <div class="admin-card-header">

                <div>
                    <h2>Top posts</h2>
                    <p>Most viewed articles.</p>
                </div>

            </div>

            <div class="admin-top-posts">

                <% topPosts.forEach((post, index) => { %>

                    <div class="admin-top-post">

                        <div class="admin-top-post-number">
                            <%= index + 1 %>
                        </div>

                        <div class="admin-top-post-content">

                            <a
                                href="/article/<%= post.slug %>"
                                target="_blank"
                            >
                                <%= post.title %>
                            </a>

                            <span>
                                <%= Number(post.views || 0).toLocaleString() %> views
                            </span>

                        </div>

                    </div>

                <% }) %>

                <% if (topPosts.length === 0) { %>

                    <div class="admin-empty">
                        No articles found.
                    </div>

                <% } %>

            </div>

        </section>

    </div>

    <!-- Categories -->

    <section class="admin-card">

        <div class="admin-card-header">

            <div>
                <h2>Categories</h2>
                <p>Article distribution and views by category.</p>
            </div>

        </div>

        <div class="admin-category-grid">

            <% categoryStats.forEach(category => { %>

                <% const categoryPercentage = stats.totalPosts
                    ? (Number(category.total) / Number(stats.totalPosts)) * 100
                    : 0;
                %>

                <div class="admin-category-card">

                    <div class="admin-category-header">

                        <strong>
                            <%= category.category %>
                        </strong>

                        <span>
                            <%= category.total %> articles
                        </span>

                    </div>

                    <div class="admin-category-bar">

                        <div
                            class="admin-category-bar-fill"
                            style="width: <%= categoryPercentage %>%"
                        ></div>

                    </div>

                    <div class="admin-category-footer">

                        <span>
                            <%= Number(category.views || 0).toLocaleString() %> views
                        </span>

                        <span>
                            <%= Math.round(categoryPercentage) %>%
                        </span>

                    </div>

                </div>

            <% }) %>

            <% if (categoryStats.length === 0) { %>

                <div class="admin-empty">
                    No category data available.
                </div>

            <% } %>

        </div>

    </section>

    <!-- Platform status -->

    <div class="admin-dashboard-grid">

        <!-- Search engine -->

        <section class="admin-card">

            <div class="admin-card-header">

                <div>
                    <h2>Search engine status</h2>
                    <p>Search Console integration status.</p>
                </div>

            </div>

            <div class="admin-status-list">

                <div class="admin-status-row">
                    <span>Indexed</span>
                    <strong class="admin-status-pending">—</strong>
                </div>

                <div class="admin-status-row">
                    <span>Pending</span>
                    <strong class="admin-status-pending">—</strong>
                </div>

                <div class="admin-status-row">
                    <span>Errors</span>
                    <strong class="admin-status-pending">—</strong>
                </div>

                <div class="admin-status-row">
                    <span>Sitemap</span>
                    <strong class="admin-status-active">Active</strong>
                </div>

            </div>

        </section>

        <!-- AI activity -->

        <section class="admin-card">

            <div class="admin-card-header">

                <div>
                    <h2>AI activity</h2>
                    <p>AI-generated content activity.</p>
                </div>

            </div>

            <div class="admin-placeholder">

                <span class="admin-placeholder-icon">
                    AI
                </span>

                <strong>
                    No AI activity data yet
                </strong>

                <p>
                    AI generation statistics will appear here once the
                    content generation system is connected.
                </p>

            </div>

        </section>

    </div>

    <!-- Alerts -->

    <section class="admin-card admin-alert-card">

        <div class="admin-card-header">

            <div>
                <h2>Alerts</h2>
                <p>Important platform notifications.</p>
            </div>

        </div>

        <div class="admin-alert-empty">

            <span>✓</span>

            <div>
                <strong>
                    No active alerts
                </strong>

                <p>
                    Everything looks good right now.
                </p>
            </div>

        </div>

    </section>

</main>

<%- include("footer") %>