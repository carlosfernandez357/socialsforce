<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | SocialsForce</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <%- include("../../admin/partials/header") %>

    <div class="admin-layout">

        <%- include("../../admin/partials/sidebar") %>

        <main class="admin-main">

            <div class="admin-page-header">
                <div>
                    <h1>Dashboard</h1>
                    <p>Overview of your SocialsForce platform.</p>
                </div>
            </div>


            <section class="stats-grid">

                <div class="stat-card">
                    <span class="stat-label">Total Views</span>
                    <strong class="stat-value"><%= stats.totalViews.toLocaleString() %></strong>
                    <span class="stat-description">Total article views</span>
                </div>

                <div class="stat-card">
                    <span class="stat-label">Articles</span>
                    <strong class="stat-value"><%= stats.totalPosts.toLocaleString() %></strong>
                    <span class="stat-description">Total articles</span>
                </div>

                <div class="stat-card">
                    <span class="stat-label">Categories</span>
                    <strong class="stat-value"><%= stats.totalCategories.toLocaleString() %></strong>
                    <span class="stat-description">Categories used</span>
                </div>

                <div class="stat-card">
                    <span class="stat-label">Published Today</span>
                    <strong class="stat-value"><%= stats.todayPosts.toLocaleString() %></strong>
                    <span class="stat-description">Articles published today</span>
                </div>

            </section>


            <section class="admin-section">

                <div class="section-header">
                    <div>
                        <h2>Latest articles</h2>
                        <p>Recently published content.</p>
                    </div>

                    <a href="/admin/articles" class="section-link">
                        View all
                    </a>
                </div>

                <div class="table-container">

                    <table class="admin-table">

                        <thead>
                            <tr>
                                <th>Article</th>
                                <th>Category</th>
                                <th>Views</th>
                                <th>Published</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% latestPosts.forEach(post => { %>

                                <tr>

                                    <td>
                                        <div class="article-table-title">
                                            <strong><%= post.title %></strong>
                                            <span>/article/<%= post.slug %></span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="category-badge">
                                            <%= post.category || "Uncategorized" %>
                                        </span>
                                    </td>

                                    <td>
                                        <%= post.views.toLocaleString() %>
                                    </td>

                                    <td>
                                        <%= post.published_at ? new Date(post.published_at).toLocaleDateString("en-GB") : "-" %>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </section>


            <section class="admin-section">

                <div class="section-header">
                    <div>
                        <h2>Content overview</h2>
                        <p>Information calculated directly from your articles.</p>
                    </div>
                </div>

                <div class="status-grid">

                    <div class="status-card">
                        <span>Total content views</span>
                        <strong><%= stats.totalViews.toLocaleString() %></strong>
                        <small>Across all articles</small>
                    </div>

                    <div class="status-card">
                        <span>Average views</span>
                        <strong><%= stats.totalPosts > 0 ? Math.round(stats.totalViews / stats.totalPosts).toLocaleString() : 0 %></strong>
                        <small>Views per article</small>
                    </div>

                    <div class="status-card">
                        <span>Articles today</span>
                        <strong><%= stats.todayPosts.toLocaleString() %></strong>
                        <small>Created today</small>
                    </div>

                    <div class="status-card">
                        <span>Categories</span>
                        <strong><%= stats.totalCategories.toLocaleString() %></strong>
                        <small>Currently in use</small>
                    </div>

                </div>

            </section>


            <section class="admin-section">

                <div class="section-header">
                    <div>
                        <h2>Top articles</h2>
                        <p>Articles with the highest number of views.</p>
                    </div>
                </div>

                <div class="table-container">

                    <table class="admin-table">

                        <thead>
                            <tr>
                                <th>Article</th>
                                <th>Category</th>
                                <th>Views</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% topPosts.forEach(post => { %>

                                <tr>

                                    <td>
                                        <div class="article-table-title">
                                            <strong><%= post.title %></strong>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="category-badge">
                                            <%= post.category || "Uncategorized" %>
                                        </span>
                                    </td>

                                    <td>
                                        <%= post.views.toLocaleString() %>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </section>


            <section class="admin-section">

                <div class="section-header">
                    <div>
                        <h2>Categories</h2>
                        <p>Article distribution by category.</p>
                    </div>
                </div>

                <div class="status-grid">

                    <% categoryStats.forEach(category => { %>

                        <div class="status-card">
                            <span><%= category.category || "Uncategorized" %></span>
                            <strong><%= category.total %></strong>
                            <small><%= category.views.toLocaleString() %> total views</small>
                        </div>

                    <% }) %>

                </div>

            </section>


            <section class="admin-section">

                <div class="section-header">
                    <div>
                        <h2>SEO status</h2>
                        <p>These values will be connected to Google Search Console later.</p>
                    </div>
                </div>

                <div class="status-grid">

                    <div class="status-card">
                        <span>Indexed</span>
                        <strong>—</strong>
                        <small>Not connected yet</small>
                    </div>

                    <div class="status-card">
                        <span>Pending</span>
                        <strong>—</strong>
                        <small>Not connected yet</small>
                    </div>

                    <div class="status-card">
                        <span>Errors</span>
                        <strong>—</strong>
                        <small>Not connected yet</small>
                    </div>

                    <div class="status-card">
                        <span>Sitemap</span>
                        <strong>Active</strong>
                        <small>Generated by SocialsForce</small>
                    </div>

                </div>

            </section>


            <section class="admin-section">

                <div class="section-header">
                    <div>
                        <h2>System</h2>
                        <p>Current SocialsForce system information.</p>
                    </div>
                </div>

                <div class="status-grid">

                    <div class="status-card">
                        <span>Database</span>
                        <strong class="status-success">Online</strong>
                        <small>MySQL connection</small>
                    </div>

                    <div class="status-card">
                        <span>Articles</span>
                        <strong><%= stats.totalPosts.toLocaleString() %></strong>
                        <small>Stored in database</small>
                    </div>

                    <div class="status-card">
                        <span>Views</span>
                        <strong><%= stats.totalViews.toLocaleString() %></strong>
                        <small>Stored in database</small>
                    </div>

                    <div class="status-card">
                        <span>AI Generator</span>
                        <strong>Ready</strong>
                        <small>API endpoint available</small>
                    </div>

                </div>

            </section>

        </main>

    </div>

    <%- include("../../admin/partials/footer") %>

</body>
</html>