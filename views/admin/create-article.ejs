</main>



<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script>


/* =========================================================
   GLOBAL STATE
   ========================================================= */

let selectedNews = null;



/* =========================================================
   HELPERS
   ========================================================= */

function escapeHtml(value) {

    return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


function logAI(message) {

    const status =
        document.getElementById("aiStatus");

    const time =
        new Date().toLocaleTimeString();

    status.textContent +=
        `\n[${time}] ${message}`;

    status.scrollTop =
        status.scrollHeight;

}



/* =========================================================
   UPDATE ARTICLE FORM
   ========================================================= */

function updateArticleForm(article) {

    document.getElementById("title").value =
        article.title || "";

    document.getElementById("slug").value =
        article.slug || "";

    document.getElementById("excerpt").value =
        article.excerpt || "";

    document.getElementById("category").value =
        article.category || "";

    document.getElementById("content").value =
        article.content || "";


    if (window.tinymce) {

        const editor =
            tinymce.get("content");

        if (editor) {

            editor.setContent(
                article.content || ""
            );

        }

    }

}



/* =========================================================
   NORMAL AI ARTICLE GENERATOR
   ========================================================= */

document
    .getElementById("aiForm")
    .addEventListener("submit", async e => {

        e.preventDefault();


        const prompt =
            document
                .getElementById("aiPrompt")
                .value
                .trim();


        const button =
            e.target.querySelector("button");


        const status =
            document.getElementById("aiStatus");


        status.textContent = "";


        logAI(
            "Starting article generation..."
        );


        logAI(
            `Prompt length: ${prompt.length} characters`
        );


        button.disabled = true;

        button.textContent =
            "Generating...";


        try {

            logAI(
                "Sending request to /createArticle..."
            );


            const response =
                await fetch(
                    "/createArticle",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            prompt
                        })
                    }
                );


            logAI(
                `Response received: HTTP ${response.status}`
            );


            if (!response.ok) {

                throw new Error(
                    `Server returned HTTP ${response.status}`
                );

            }


            const article =
                await response.json();


            logAI(
                "Article generated successfully."
            );


            logAI(
                `Title: ${article.title || "N/A"}`
            );


            logAI(
                `Slug: ${article.slug || "N/A"}`
            );


            logAI(
                `Category: ${article.category || "N/A"}`
            );


            logAI(
                `Content length: ${(article.content || "").length} characters`
            );


            updateArticleForm(article);


            logAI(
                "Form updated successfully."
            );


            logAI(
                "Done."
            );


        } catch (err) {

            logAI(
                `ERROR: ${err.message}`
            );


            console.error(
                "Article generation error:",
                err
            );


        } finally {

            button.disabled = false;

            button.textContent =
                "Generate Article";

        }

    });



/* =========================================================
   SEARCH GOOGLE NEWS
   ========================================================= */

document
    .getElementById("searchNewsButton")
    .addEventListener("click", async () => {

        const button =
            document.getElementById(
                "searchNewsButton"
            );


        const results =
            document.getElementById(
                "newsResults"
            );


        const status =
            document.getElementById(
                "newsStatus"
            );


        button.disabled = true;

        button.textContent =
            "Searching...";


        status.textContent =
            "Searching Google News...";


        results.innerHTML = "";


        /*
         * =====================================================
         * TODO:
         *
         * This endpoint should call SerpAPI using:
         *
         * engine=google_news
         *
         * and return a maximum of 10 results.
         * =====================================================
         */


        try {

            const response =
                await fetch(
                    "/admin/news/search",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({

                            limit: 10

                        })

                    }
                );


            if (!response.ok) {

                throw new Error(
                    `HTTP ${response.status}`
                );

            }


            const data =
                await response.json();


            if (
                !data.success ||
                !Array.isArray(data.news)
            ) {

                throw new Error(
                    data.error ||
                    "Invalid news response"
                );

            }


            if (data.news.length === 0) {

                status.textContent =
                    "No news found.";

                return;

            }


            status.textContent =
                `${data.news.length} news results found.`;


            results.innerHTML =
                data.news
                    .slice(0, 10)
                    .map((article, index) => {

                        return `

                            <div
                                class="news-result"
                                data-index="${index}"
                                style="
                                    padding: 18px;
                                    border: 1px solid #ddd;
                                    border-radius: 10px;
                                    cursor: pointer;
                                    transition: 0.15s;
                                    background: #fff;
                                "
                            >

                                <div
                                    style="
                                        display: flex;
                                        gap: 15px;
                                    "
                                >

                                    ${
                                        article.thumbnail
                                            ? `
                                                <img
                                                    src="${escapeHtml(article.thumbnail)}"
                                                    style="
                                                        width: 120px;
                                                        height: 80px;
                                                        object-fit: cover;
                                                        border-radius: 7px;
                                                    "
                                                >
                                            `
                                            : ""
                                    }


                                    <div>

                                        <h3
                                            style="
                                                margin: 0 0 7px;
                                            "
                                        >
                                            ${escapeHtml(article.title)}
                                        </h3>


                                        <div
                                            style="
                                                font-size: 13px;
                                                color: #777;
                                            "
                                        >

                                            <strong>
                                                ${escapeHtml(article.source)}
                                            </strong>

                                            ${
                                                article.date
                                                    ? `
                                                        ·
                                                        ${escapeHtml(article.date)}
                                                    `
                                                    : ""
                                            }

                                        </div>


                                        ${
                                            article.snippet
                                                ? `
                                                    <p
                                                        style="
                                                            margin: 8px 0 0;
                                                            color: #555;
                                                        "
                                                    >
                                                        ${escapeHtml(article.snippet)}
                                                    </p>
                                                `
                                                : ""
                                        }

                                    </div>

                                </div>

                            </div>

                        `;

                    })
                    .join("");


            document
                .querySelectorAll(".news-result")
                .forEach(element => {

                    element.addEventListener(
                        "click",
                        () => {

                            const index =
                                Number(
                                    element.dataset.index
                                );


                            selectNews(
                                data.news[index]
                            );

                        }
                    );

                });


        } catch (error) {

            console.error(
                "News search error:",
                error
            );


            status.textContent =
                `Error: ${error.message}`;


        } finally {

            button.disabled = false;

            button.textContent =
                "Search News";

        }

    });



/* =========================================================
   SELECT NEWS
   ========================================================= */

function selectNews(article) {

    selectedNews =
        article;


    const section =
        document.getElementById(
            "selectedNewsSection"
        );


    const container =
        document.getElementById(
            "selectedNews"
        );


    section.style.display =
        "block";


    container.innerHTML = `

        <h3>
            ${escapeHtml(article.title)}
        </h3>


        <p
            style="
                color: #777;
            "
        >

            <strong>
                ${escapeHtml(article.source || "Unknown source")}
            </strong>

            ${
                article.date
                    ? `
                        ·
                        ${escapeHtml(article.date)}
                    `
                    : ""
            }

        </p>


        ${
            article.snippet
                ? `
                    <p>
                        ${escapeHtml(article.snippet)}
                    </p>
                `
                : ""
        }


        ${
            article.link
                ? `
                    <a
                        href="${escapeHtml(article.link)}"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Open original article
                    </a>
                `
                : ""
        }

    `;


    section.scrollIntoView({
        behavior: "smooth",
        block: "start"
    });

}



/* =========================================================
   GENERATE ARTICLE FROM SELECTED NEWS
   ========================================================= */

document
    .getElementById(
        "generateNewsArticleButton"
    )
    .addEventListener(
        "click",
        async () => {

            if (!selectedNews) {

                alert(
                    "Please select a news article first."
                );

                return;

            }


            const prompt =
                document
                    .getElementById(
                        "newsPrompt"
                    )
                    .value
                    .trim();


            const button =
                document.getElementById(
                    "generateNewsArticleButton"
                );


            const status =
                document.getElementById(
                    "aiStatus"
                );


            status.textContent =
                "";


            logAI(
                "Starting article generation from news..."
            );


            logAI(
                `Selected news: ${selectedNews.title}`
            );


            logAI(
                `Source: ${selectedNews.source || "Unknown"}`
            );


            button.disabled = true;

            button.textContent =
                "Generating...";


            try {

                /*
                 * =================================================
                 * The API receives TWO separate pieces of data:
                 *
                 * prompt = user's instructions
                 *
                 * info = information obtained from Google News
                 *
                 * =================================================
                 */

                const response =
                    await fetch(
                        "/createArticle",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({

                                prompt: prompt,

                                info: {

                                    title:
                                        selectedNews.title,

                                    source:
                                        selectedNews.source,

                                    date:
                                        selectedNews.date,

                                    snippet:
                                        selectedNews.snippet,

                                    link:
                                        selectedNews.link

                                }

                            })

                        }
                    );


                logAI(
                    `Response received: HTTP ${response.status}`
                );


                if (!response.ok) {

                    throw new Error(
                        `Server returned HTTP ${response.status}`
                    );

                }


                const article =
                    await response.json();


                logAI(
                    "Article generated successfully."
                );


                logAI(
                    `Title: ${article.title || "N/A"}`
                );


                logAI(
                    `Content length: ${(article.content || "").length} characters`
                );


                updateArticleForm(
                    article
                );


                logAI(
                    "Article form updated successfully."
                );


                logAI(
                    "Done."
                );


            } catch (error) {

                logAI(
                    `ERROR: ${error.message}`
                );


                console.error(
                    "News article generation error:",
                    error
                );


            } finally {

                button.disabled = false;

                button.textContent =
                    "Generate Article";

            }

        }
    );

</script>



