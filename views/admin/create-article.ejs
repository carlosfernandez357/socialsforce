<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="admin-main">
    <link rel="stylesheet" href="/css/admin.css">
    <div class="admin-page-header">
        <div>
            <h1>Create Article</h1>
            <p>Create articles manually or generate them with AI.</p>
        </div>
    </div>
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js"></script>
    <div class="admin-create-layout">

        <div class="admin-card">

            <div class="admin-card-header">
                <h2>AI Generator</h2>
            </div>

            <form id="aiForm">

                <div class="admin-form-group">
                    <label>Topic</label>
                    <textarea type="text"id="aiPrompt"></textarea>
                </div>

                <button
                    type="submit"
                    class="admin-primary-button"
                >
                    Generate Article
                </button>

            </form>
            <div class="admin-ai-status" id="aiStatus">
                Waiting...
            </div>
            <button type="button" class="admin-ai-clear" onclick="document.getElementById('aiStatus').innerHTML = ''">
                Clear Console
            </button>
        </div>

        <div class="admin-card">

            <div class="admin-card-header">
                <h2>Article Information</h2>
            </div>

            <form
                action="/admin/articles/create"
                method="POST"
            >

                <div class="admin-form-group">
                    <label>Title</label>
                    <input
                        type="text"
                        name="title"
                        id="title"
                        required
                    >
                </div>

                <div class="admin-form-group">
                    <label>Slug</label>
                    <input
                        type="text"
                        name="slug"
                        id="slug"
                        required
                    >
                </div>

                <div class="admin-form-group">
                    <label>Category</label>
                    <input
                        type="text"
                        name="category"
                        id="category"
                        required
                    >
                </div>
                <div class="admin-form-group">
                    <label>Tags</label>

                    <input
                        type="text"
                        name="tags"
                        id="tags"
                        placeholder="OpenAI, ChatGPT, GPT-5, LLM"
                    >

                    <small>
                        Separate tags with commas.
                    </small>
                </div>

                <div class="admin-form-group">
                    <label>Topics (recommendations)</label>
                    <input
                        type="text"
                        name="topics"
                        id="topics"
                        placeholder="OpenAI:9, ChatGPT:7, AI regulation:4"
                    >
                    <small>
                        Name:weight (1-10), separated by commas. Optional: if empty, tags are used.
                    </small>
                </div>

                <div class="admin-form-group">
                    <label>Evergreen (0 = news that expires fast, 10 = always relevant)</label>
                    <input type="number" name="evergreen" id="evergreen" min="0" max="10" value="3">
                </div>

                <div class="admin-form-group">
                    <label>Depth (1 = short news, 10 = in-depth analysis)</label>
                    <input type="number" name="depth" id="depth" min="1" max="10" value="5">
                </div>

                <div class="admin-form-group">
                    <label>Excerpt</label>
                    <textarea
                        name="excerpt"
                        id="excerpt"
                        rows="4"
                    ></textarea>
                </div>

                <div class="admin-form-group">
                    <label>Featured Image</label>
                    <input
                        type="text"
                        name="image"
                        id="image"
                        placeholder="https://..."
                    >
                </div>

                <div class="admin-form-group">
                    <label>Content (HTML)</label>
                    <textarea name="content" id="content"></textarea>
                </div>

                <button
                    type="submit"
                    class="admin-primary-button"
                >
                    Publish Article
                </button>

            </form>

        </div>

    </div>






















<!-- =========================================================
     SECCIÓN DE NOTICIAS
     Añadir debajo de la sección actual de creación de artículos
========================================================= -->

<div class="admin-card" style="margin-top: 30px;">

    <h2>Noticias</h2>

    <p>
        Busca las últimas noticias y selecciona una para generar
        un artículo.
    </p>

    <button
        type="button"
        class="admin-btn"
        id="searchNewsBtn"
    >
        Buscar noticias
    </button>

    <div id="newsStatus" class="admin-ai-status">
        Pulsa "Buscar noticias" para cargar las últimas noticias.
    </div>

    <div id="newsResults"></div>


    <!-- NOTICIA SELECCIONADA -->

    <div id="selectedNewsContainer" style="display:none;">

        <h3>Noticia seleccionada</h3>

        <div id="selectedNews"></div>

        <div class="form-group">

            <label for="newsPrompt">
                Instrucciones para el artículo
            </label>

            <textarea
                id="newsPrompt"
                rows="6"
                placeholder="Escribe cómo quieres que la IA cree el artículo..."
            ></textarea>

        </div>

        <button
            type="button"
            class="admin-btn"
            id="generateNewsArticleBtn"
        >
            Generar artículo
        </button>

        <div
            id="newsGenerateStatus"
            class="admin-ai-status"
        ></div>

    </div>

</div>


<script>
(function () {
    const searchBtn = document.getElementById("searchNewsBtn");
    const results = document.getElementById("newsResults");
    const status = document.getElementById("newsStatus");
    const selectedBox = document.getElementById("selectedNewsContainer");
    const selectedView = document.getElementById("selectedNews");
    const promptEl = document.getElementById("newsPrompt");
    const generateBtn = document.getElementById("generateNewsArticleBtn");
    const generateStatus = document.getElementById("newsGenerateStatus");
    let selectedNews = null;

    function pickNews(item) {
        selectedNews = item;
        selectedBox.style.display = "block";
        selectedView.innerHTML = `<strong>${item.title || "Sin título"}</strong><br><small>${item.source?.name || ""}</small><br><a href="${item.link || "#"}" target="_blank">Abrir fuente</a>`;
    }

    searchBtn.addEventListener("click", async () => {
        searchBtn.disabled = true;
        status.textContent = "Buscando noticias...";
        results.innerHTML = "";
        try {
            const response = await fetch("/admin/news");
            const data = await response.json();
            const items = Array.isArray(data.news_results) ? data.news_results : [];
            if (!response.ok) throw new Error(data.error || "No se pudieron cargar noticias");
            if (!items.length) {
                status.textContent = "No se encontraron noticias.";
                return;
            }
            status.textContent = `Se encontraron ${items.length} noticias.`;
            results.innerHTML = items.map((item, i) => `<div class="admin-news-item"><button type="button" data-news-index="${i}" class="admin-btn">Seleccionar</button> <strong>${item.title || "Sin título"}</strong></div>`).join("");
            results.querySelectorAll("[data-news-index]").forEach(btn => {
                btn.addEventListener("click", () => pickNews(items[Number(btn.getAttribute("data-news-index"))]));
            });
        } catch (error) {
            status.textContent = `Error: ${error.message}`;
        } finally {
            searchBtn.disabled = false;
        }
    });

    generateBtn.addEventListener("click", async () => {
        if (!selectedNews) return generateStatus.textContent = "Selecciona primero una noticia.";
        const extraPrompt = promptEl.value.trim();
        if (!extraPrompt) return generateStatus.textContent = "Escribe las instrucciones para la IA.";
        generateBtn.disabled = true;
        generateBtn.textContent = "Generando...";
        generateStatus.textContent = "Generando artículo...";
        try {
            const prompt = `Instrucciones: ${extraPrompt}\n\nInfo:\n${JSON.stringify(selectedNews, null, 2)}`;
            const response = await fetch("/createArticle", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ prompt })
            });
            const data = await response.json();
            if (!response.ok || !data.success) throw new Error(data.error || "Error generando el artículo");
            generateStatus.textContent = "Artículo generado correctamente.";
            if (data.title) document.getElementById("title").value = data.title;
            if (data.slug) document.getElementById("slug").value = data.slug;
            if (data.excerpt) document.getElementById("excerpt").value = data.excerpt;
            if (data.category) document.getElementById("category").value = data.category;
            if (data.image) document.getElementById("image").value = data.image;
            if (Array.isArray(data.tags)) document.getElementById("tags").value = data.tags.join(", ");
            if (data.content) {
                const editor = tinymce.get("content");
                if (editor) editor.setContent(data.content);
            }
        } catch (error) {
            generateStatus.textContent = `Error: ${error.message}`;
        } finally {
            generateBtn.disabled = false;
            generateBtn.textContent = "Generar artículo";
        }
    });
})();
</script>











































</main>


<script>

document.getElementById("aiForm").addEventListener("submit", async e => {

    e.preventDefault();

    const prompt = document.getElementById("aiPrompt").value;
    const button = e.target.querySelector("button");
    const status = document.getElementById("aiStatus");

    // Función para escribir en la consola
    function log(message) {
        const time = new Date().toLocaleTimeString();
        status.textContent += `\n[${time}] ${message}`;
        status.scrollTop = status.scrollHeight;
    }

    // Limpiar consola
    status.textContent = "";

    log("Starting article generation...");
    log(`Prompt length: ${prompt.length} characters`);

    button.disabled = true;
    button.textContent = "Generating...";

    try {

        log("Sending request to /createArticle...");

        const response = await fetch("/createArticle", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ prompt })
        });

        log(`Response received: HTTP ${response.status}`);

        if (!response.ok) {
            throw new Error(`Server returned HTTP ${response.status}`);
        }

        log("Parsing response...");

        const article = await response.json();
        if (!article.success) {
            throw new Error(article.error || "No se pudo generar el artículo");
        }

        log("Article generated successfully.");
        log(`Title: ${article.title || "N/A"}`);
        log(`Slug: ${article.slug || "N/A"}`);
        log(`Category: ${article.category || "N/A"}`);
        log(`Content length: ${(article.content || "").length} characters`);

        document.getElementById("title").value = article.title || "";
        document.getElementById("slug").value = article.slug || "";
        document.getElementById("excerpt").value = article.excerpt || "";
        document.getElementById("category").value = article.category || "";
        document.getElementById("image").value = article.image || "";
        document.getElementById("tags").value = Array.isArray(article.tags) ? article.tags.join(", ") : "";

        const editor = tinymce.get("content");
        if (editor) {
            editor.setContent(article.content || "");
        } else {
            document.getElementById("content").value = article.content || "";
        }

        log("Form updated successfully.");
        log("Done.");

    } catch (err) {

        log(`ERROR: ${err.message}`);
        console.error("Article generation error:", err);

    } finally {

        button.disabled = false;
        button.textContent = "Generate Article";

    }

});

</script>

<script>
tinymce.init({
    selector: "#content",
    height: 700,
    menubar: true,
    plugins: [
        "lists",
        "link",
        "image",
        "table",
        "code",
        "fullscreen",
        "preview"
    ],
    toolbar:
        "undo redo | styles | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image table | code fullscreen preview"
});
</script>

