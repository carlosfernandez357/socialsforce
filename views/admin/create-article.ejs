<!-- =========================================================
     TINYMCE
========================================================== -->

<script
    src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js"
    referrerpolicy="origin"
></script>


<script>

    /* =========================================================
       TINYMCE
    ========================================================== */

    tinymce.init({

        selector: "#content",

        height: 700,

        plugins: [
            "lists",
            "link",
            "image",
            "table",
            "code",
            "fullscreen",
            "preview"
        ],

        toolbar:
            "undo redo | blocks | " +
            "bold italic underline | " +
            "alignleft aligncenter alignright | " +
            "bullist numlist | " +
            "link image table | " +
            "code fullscreen preview"

    });


    /* =========================================================
       GENERADOR IA NORMAL
    ========================================================== */

    const aiForm = document.getElementById("aiForm");

    const aiStatus = document.getElementById("aiStatus");

    const generateBtn = document.getElementById("generateBtn");

    const clearAiStatus =
        document.getElementById("clearAiStatus");


    function logAI(message) {

        const time =
            new Date().toLocaleTimeString();

        aiStatus.innerHTML +=
            `<div>[${time}] ${message}</div>`;

        aiStatus.scrollTop =
            aiStatus.scrollHeight;
    }


    clearAiStatus.addEventListener("click", () => {

        aiStatus.innerHTML =
            "Consola limpiada.";

    });


    aiForm.addEventListener("submit", async (event) => {

        event.preventDefault();

        const prompt =
            document.getElementById("aiPrompt").value.trim();


        if (!prompt) {

            logAI("Escribe un prompt.");

            return;

        }


        generateBtn.disabled = true;

        generateBtn.textContent =
            "Generando...";


        aiStatus.innerHTML =
            "";


        logAI("Enviando prompt a la IA...");


        try {

            const response =
                await fetch("/createArticle", {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        prompt: prompt
                    })

                });


            const data =
                await response.json();


            if (!response.ok) {

                throw new Error(
                    data.error ||
                    "Error generando el artículo"
                );

            }


            logAI(
                "Artículo generado correctamente."
            );


            /* =========================
               RELLENAR CAMPOS
            ========================== */

            document.getElementById("title").value =
                data.title || "";


            document.getElementById("slug").value =
                data.slug || "";


            document.getElementById("excerpt").value =
                data.excerpt || "";


            document.getElementById("category").value =
                data.category || "";


            if (data.content) {

                const editor =
                    tinymce.get("content");

                if (editor) {

                    editor.setContent(
                        data.content
                    );

                }

            }

        } catch (error) {

            console.error(error);

            logAI(
                "ERROR: " +
                error.message
            );

        } finally {

            generateBtn.disabled = false;

            generateBtn.textContent =
                "Generar artículo";

        }

    });



    /* =========================================================
       NOTICIAS - SERPAPI GOOGLE NEWS
    ========================================================== */

    const searchNewsBtn =
        document.getElementById("searchNewsBtn");

    const newsStatus =
        document.getElementById("newsStatus");

    const newsList =
        document.getElementById("newsList");

    const selectedNews =
        document.getElementById("selectedNews");

    const selectedNewsInfo =
        document.getElementById("selectedNewsInfo");

    const newsPromptContainer =
        document.getElementById("newsPromptContainer");


    let selectedNewsData = null;


    /* =========================================================
       BUSCAR NOTICIAS
       
       SERPAPI
       engine=google_news
       num=10
    ========================================================== */

    searchNewsBtn.addEventListener(
        "click",
        async () => {

            searchNewsBtn.disabled = true;

            searchNewsBtn.textContent =
                "Buscando noticias...";


            newsStatus.innerHTML =
                "Consultando Google News mediante SerpAPI...";


            newsList.innerHTML =
                "";


            selectedNews.style.display =
                "none";


            newsPromptContainer.style.display =
                "none";


            selectedNewsData = null;


            try {

                const response = await fetch(

                    "https://serpapi.com/search.json" +
                    "?engine=google_news" +
                    "&api_key=d42dd2e5efabf6a42880a6cb035be641061abd8bc9eeb55d88678c4e207d922e" +
                    "&hl=es" +
                    "&gl=es" +
                    "&num=10"

                );


                if (!response.ok) {

                    throw new Error(
                        "Error HTTP " +
                        response.status
                    );

                }


                const data =
                    await response.json();


                console.log(
                    "SERPAPI GOOGLE NEWS:",
                    data
                );


                const news =
                    (data.news_results || [])
                    .slice(0, 10);


                if (!news.length) {

                    newsStatus.innerHTML =
                        "No se han encontrado noticias.";

                    return;

                }


                newsStatus.innerHTML =
                    `Se han encontrado ${news.length} noticias.`;


                /* =========================
                   MOSTRAR NOTICIAS
                ========================== */

                news.forEach(
                    (article, index) => {

                        const card =
                            document.createElement("div");


                        card.style.cssText = `
                            padding:16px;
                            border:1px solid #ddd;
                            border-radius:10px;
                            cursor:pointer;
                            background:#fff;
                            transition:0.15s;
                        `;


                        const source =
                            typeof article.source === "object"
                                ? (
                                    article.source?.name ||
                                    ""
                                )
                                : (
                                    article.source ||
                                    ""
                                );


                        const title =
                            article.title ||
                            "Sin título";


                        const snippet =
                            article.snippet ||
                            "";


                        const date =
                            article.date ||
                            "";


                        const link =
                            article.link ||
                            "";


                        const thumbnail =
                            article.thumbnail ||
                            "";


                        card.innerHTML = `

                            <div style="
                                display:flex;
                                gap:15px;
                                align-items:flex-start;
                            ">

                                ${
                                    thumbnail
                                    ? `
                                        <img
                                            src="${thumbnail}"
                                            style="
                                                width:120px;
                                                height:80px;
                                                object-fit:cover;
                                                border-radius:7px;
                                                flex-shrink:0;
                                            "
                                        >
                                      `
                                    : ""
                                }

                                <div style="
                                    flex:1;
                                ">

                                    <div style="
                                        font-size:12px;
                                        color:#777;
                                        margin-bottom:5px;
                                    ">
                                        #${index + 1}
                                        ${
                                            source
                                            ? " · " + source
                                            : ""
                                        }
                                        ${
                                            date
                                            ? " · " + date
                                            : ""
                                        }
                                    </div>


                                    <h3 style="
                                        margin:0 0 7px 0;
                                        font-size:17px;
                                    ">
                                        ${title}
                                    </h3>


                                    ${
                                        snippet
                                        ? `
                                            <p style="
                                                margin:0;
                                                color:#555;
                                                line-height:1.5;
                                            ">
                                                ${snippet}
                                            </p>
                                          `
                                        : ""
                                    }

                                </div>

                            </div>

                        `;


                        card.addEventListener(
                            "mouseenter",
                            () => {

                                card.style.borderColor =
                                    "#999";

                            }
                        );


                        card.addEventListener(
                            "mouseleave",
                            () => {

                                card.style.borderColor =
                                    "#ddd";

                            }
                        );


                        card.addEventListener(
                            "click",
                            () => {

                                /* =========================
                                   GUARDAR NOTICIA
                                ========================== */

                                selectedNewsData = {

                                    title:
                                        title,

                                    source:
                                        source,

                                    date:
                                        date,

                                    snippet:
                                        snippet,

                                    link:
                                        link,

                                    thumbnail:
                                        thumbnail

                                };


                                /* =========================
                                   MOSTRAR SELECCIONADA
                                ========================== */

                                selectedNewsInfo.innerHTML = `

                                    <p>
                                        <strong>Título:</strong>
                                        ${title}
                                    </p>

                                    ${
                                        source
                                        ? `
                                            <p>
                                                <strong>Fuente:</strong>
                                                ${source}
                                            </p>
                                          `
                                        : ""
                                    }

                                    ${
                                        date
                                        ? `
                                            <p>
                                                <strong>Fecha:</strong>
                                                ${date}
                                            </p>
                                          `
                                        : ""
                                    }

                                    ${
                                        snippet
                                        ? `
                                            <p>
                                                <strong>Resumen:</strong>
                                                ${snippet}
                                            </p>
                                          `
                                        : ""
                                    }

                                    ${
                                        link
                                        ? `
                                            <p>
                                                <strong>Enlace:</strong>
                                                <a
                                                    href="${link}"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >
                                                    Ver noticia original
                                                </a>
                                            </p>
                                          `
                                        : ""
                                    }

                                `;


                                selectedNews.style.display =
                                    "block";


                                newsPromptContainer.style.display =
                                    "block";


                                /* Scroll hacia la selección */

                                selectedNews.scrollIntoView({
                                    behavior: "smooth",
                                    block: "center"
                                });

                            }
                        );


                        newsList.appendChild(card);

                    }
                );


            } catch (error) {

                console.error(
                    "SERPAPI ERROR:",
                    error
                );


                newsStatus.innerHTML =
                    "ERROR: " +
                    error.message;

            } finally {

                searchNewsBtn.disabled = false;

                searchNewsBtn.textContent =
                    "Buscar últimas noticias";

            }

        }
    );



    /* =========================================================
       GENERAR ARTÍCULO A PARTIR DE NOTICIA
    ========================================================== */

    const generateNewsArticleBtn =
        document.getElementById(
            "generateNewsArticleBtn"
        );


    generateNewsArticleBtn.addEventListener(
        "click",
        async () => {

            if (!selectedNewsData) {

                alert(
                    "Selecciona primero una noticia."
                );

                return;

            }


            const prompt =
                document
                    .getElementById("newsPrompt")
                    .value
                    .trim();


            if (!prompt) {

                alert(
                    "Escribe las instrucciones adicionales para la IA."
                );

                return;

            }


            generateNewsArticleBtn.disabled =
                true;


            generateNewsArticleBtn.textContent =
                "Generando artículo...";


            newsStatus.innerHTML =
                "Enviando prompt + información de la noticia a la IA...";


            try {

                /* =========================
                   ENVÍO AL MISMO ENDPOINT
                   
                   {
                       prompt: "...",
                       info: {
                           ...
                       }
                   }
                ========================== */

                const response =
                    await fetch(
                        "/createArticle",
                        {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({

                                prompt:
                                    prompt,

                                info:
                                    selectedNewsData

                            })

                        }
                    );


                const data =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        data.error ||
                        "Error generando el artículo"
                    );

                }


                console.log(
                    "ARTÍCULO GENERADO DESDE NOTICIA:",
                    data
                );


                newsStatus.innerHTML =
                    "Artículo generado correctamente.";


                /* =========================
                   RELLENAR FORMULARIO
                ========================== */

                document.getElementById("title").value =
                    data.title || "";


                document.getElementById("slug").value =
                    data.slug || "";


                document.getElementById("excerpt").value =
                    data.excerpt || "";


                document.getElementById("category").value =
                    data.category || "";


                /* =========================
                   CONTENIDO TINYMCE
                ========================== */

                if (data.content) {

                    const editor =
                        tinymce.get("content");


                    if (editor) {

                        editor.setContent(
                            data.content
                        );

                    }

                }


                /* =========================
                   SCROLL AL FORMULARIO
                ========================== */

                document
                    .getElementById("articleForm")
                    .scrollIntoView({

                        behavior: "smooth",

                        block: "start"

                    });


            } catch (error) {

                console.error(
                    "NEWS ARTICLE ERROR:",
                    error
                );


                newsStatus.innerHTML =
                    "ERROR: " +
                    error.message;

            } finally {

                generateNewsArticleBtn.disabled =
                    false;


                generateNewsArticleBtn.textContent =
                    "Generar artículo con esta noticia";

            }

        }
    );

</script>
```
