    <div class="admin-card">

        <div class="admin-card-header">

            <h2>Generate Article From News</h2>

            <p>
                Search Google News, select a news article and
                provide additional instructions for the AI.
            </p>

        </div>


        <!-- =================================================
             SEARCH NEWS
