                    margin-top: 25px;
                "
            >

                <div class="admin-form-group">

                    <label>
                        Additional Prompt
                    </label>

                    <textarea
                        id="newsPrompt"
                        rows="7"
                        placeholder="Tell the AI how you want the article to be created.

Example:
Focus on the technical implications of this news.
Explain what happened, why it matters and how it could affect users.
Do not simply rewrite the original article."
                    ></textarea>

                </div>


                <button
                    type="button"
                    id="generateNewsArticleButton"
