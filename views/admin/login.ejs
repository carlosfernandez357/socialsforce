<form
    action="/admin"
    method="POST"
>

    <div class="form-group">

        <label for="username">
            Username
        </label>

        <input
            id="username"
            type="text"
            name="username"
            required
        >

    </div>


    <div class="form-group">

        <label for="password">
            Password
        </label>

        <input
            id="password"
            type="password"
            name="password"
            required
        >

    </div>


    <% if (error) { %>

        <div class="login-error">

            <%= error %>

        </div>

    <% } %>


    <button type="submit">
        Login
    </button>

</form>