<%- include('partials/page-start', { seo: {
    title: topic.name + ' - News and Analysis | SocialsForce',
    description: 'Latest news, stories and analysis about ' + topic.name + ' on SocialsForce.',
    canonical: 'https://socialsforce.com/topic/' + topic.slug,
    robots: posts.length >= 2 ? 'index, follow, max-image-preview:large' : 'noindex, follow'
} }) %>

    <main id="topic-page">
        <section class="listing-page-section">
            <div class="content-container">
                <div class="listing-page-header">
                    <span class="listing-page-label">Topic</span>
                    <h1 class="listing-page-title"><%= topic.name %></h1>
                    <p class="listing-page-description">All our stories about <%= topic.name %>.</p>
                    <% if (relatedTopics && relatedTopics.length) { %>
                    <div class="sidebar-pills topic-related">
                        <% relatedTopics.forEach(t => { %>
                        <a href="/topic/<%= t.slug %>" class="sidebar-pill"><%= t.name %></a>
                        <% }) %>
                    </div>
                    <% } %>
                </div>

                <div class="content-sidebar-layout">
                    <div class="main-content">
                        <% if (posts.length) { %>
                        <div class="listing-posts-grid">
                            <% posts.forEach(post => { %>
                            <article class="post-card">
                                <a href="/article/<%= post.slug %>">
                                    <% if (post.image) { %>
                                    <img src="<%= post.image %>" alt="<%= post.title %>" class="post-image" loading="lazy">
                                    <% } %>
                                    <div class="post-content">
                                        <span class="post-category"><%= post.category %></span>
                                        <h2 class="post-title"><%= post.title %></h2>
                                        <% if (post.excerpt) { %><p class="post-summary"><%= post.excerpt %></p><% } %>
                                        <span class="post-date"><%= new Date(post.published_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %></span>
                                    </div>
                                </a>
                            </article>
                            <% }) %>
                        </div>
                        <% } else { %>
                        <div class="empty-posts"><h2>No articles found</h2><p>There are no published articles about this topic yet.</p></div>
                        <% } %>
                    </div>
                    <aside class="sidebar" aria-label="More articles">
                        <%- include('partials/sidebar', { sidebarData: typeof sidebarData !== "undefined" ? sidebarData : null }) %>
                    </aside>
                </div>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>
    <script src="/js/main.js"></script>
</body>
</html>
